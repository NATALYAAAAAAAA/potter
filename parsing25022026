import requests
from bs4 import BeautifulSoup
import time
import csv
import pandas as pd
import logging
from sqlalchemy import create_engine, text
from tenacity import retry, stop_after_attempt, wait_fixed, retry_if_exception_type

# --- настройки ---
class Config:
    def __init__(self):
        self.headers = {
            'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36',
            'Accept-Language': 'en-US,en;q=0.9',
        }
        self.delay = 1
        self.retries = 3
        self.timeout = 10

cfg = Config()
BASE_URL = "http://web-scraping.dev/products"

logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

# --- функция с повторами если упало соединение ---
@retry(
    stop=stop_after_attempt(cfg.retries),
    wait=wait_fixed(2),
    retry=retry_if_exception_type((requests.RequestException, ConnectionError)),
    before_sleep=lambda x: logger.warning(f"попытка {x.attempt_number} не вышла, спим {x.next_action.sleep}с")
)
def get_page(url, params=None):
    try:
        logger.info(f"идем на {url} с {params}")
        resp = requests.get(url, headers=cfg.headers, params=params, timeout=cfg.timeout)
        resp.raise_for_status()
        return resp.text
    except requests.exceptions.Timeout:
        logger.error("таймаут")
        raise
    except requests.exceptions.HTTPError as e:
        if resp.status_code == 404:
            logger.error(f"404 {url}")
            return None
        else:
            logger.error(f"http {resp.status_code}")
            raise
    except Exception as e:
        logger.error(f"что-то сломалось: {e}")
        raise

# --- вытаскиваем продукты со страницы ---
def parse_products(html):
    soup = BeautifulSoup(html, 'html.parser')
    items = []
    
    # ищем блоки с товарами, на сайте они вроде во всяких дивах
    blocks = soup.find_all('div', class_='product')
    if not blocks:
        blocks = soup.find_all('h3')  # может быть просто заголовками
    
    for b in blocks:
        p = {}
        
        # название
        title_tag = b.find('h3')
        if title_tag:
            p['title'] = title_tag.text.strip()
        else:
            p['title'] = b.text.strip() if b.name == 'h3' else 'нет названия'
        
        # цена - ищем где есть доллар
        price_tag = b.find_next('p')
        if price_tag and '$' in price_tag.text:
            p['price'] = price_tag.text.strip()
        else:
            # бывает что цена не там, пройдемся по тексту
            found = False
            for t in b.find_all(text=True):
                if '$' in t:
                    p['price'] = t.strip()
                    found = True
                    break
            if not found:
                p['price'] = 'N/A'
        
        # описание - часто в следующем абзаце
        desc = b.find_next('p', class_='description')
        if not desc:
            # ну ок, возьмем любой p дальше
            for x in b.find_all_next('p'):
                if len(x.text) > 40 and '$' not in x.text:  # похоже на описание
                    desc = x
                    break
        p['description'] = desc.text.strip() if desc else ''
        
        # ссылка если есть
        link = b.find('a')
        p['url'] = link['href'] if link and link.get('href') else ''
        
        items.append(p)
    return items

# --- основной цикл по страницам ---
def scrape_all():
    all_data = []
    page = 1
    
    while True:
        logger.info(f"страница {page}")
        params = {'page': page} if page > 1 else None
        
        html = get_page(BASE_URL, params=params)
        if not html:
            break
        
        data = parse_products(html)
        if not data:
            logger.info(f"пусто на {page}")
            break
        
        all_data.extend(data)
        logger.info(f"добавили {len(data)}")
        
        # проверяем есть ли дальше
        soup = BeautifulSoup(html, 'html.parser')
        next_btn = soup.find('a', string='Next')
        if not next_btn or page >= 5:  # на сайте 5 страниц вроде
            break
        
        page += 1
        time.sleep(cfg.delay)
    
    return all_data

# --- сохранение и простые метрики ---
def save_with_stats(data, fname='prods.csv'):
    df = pd.DataFrame(data)
    
    # почистим цену для цифр
    df['price_clean'] = df['price'].replace('N/A', None)
    df['price_num'] = df['price_clean'].str.replace('$', '').astype(float, errors='ignore')
    
    print("проверка пропусков:")
    print(df[['title', 'price']].isna().sum())
    
    if df['price_num'].notna().any():
        print("\nцены:")
        print(f"средняя: ${df['price_num'].mean():.2f}")
        print(f"мин: ${df['price_num'].min():.2f}")
        print(f"макс: ${df['price_num'].max():.2f}")
    
    df.to_csv(fname, index=False)
    logger.info(f"сохранено в {fname}")
    return df

# --- запись в бд (если надо) ---
def to_db(df, conn_str, table='products'):
    if not conn_str:
        logger.info("нет строки подключения, пропускаем бд")
        return
    try:
        engine = create_engine(conn_str)
        with engine.connect() as c:
            c.execute(text(f"""
                CREATE TABLE IF NOT EXISTS {table} (
                    id SERIAL PRIMARY KEY,
                    title TEXT,
                    price TEXT,
                    description TEXT,
                    url TEXT,
                    price_num FLOAT
                )
            """))
            c.commit()
        df.to_sql(table, engine, if_exists='replace', index=False)
        logger.info(f"залили в {table}")
    except Exception as e:
        logger.error(f"бд упала: {e}")

if __name__ == "__main__":
    print("погнали...")
    products = scrape_all()
    
    if products:
        print(f"всего {len(products)}")
        df = save_with_stats(products)
        # to_db(df, "postgresql://user:pass@localhost/db")  # тут раскомментировать если надо
    else:
        print("ничего не собралось")
